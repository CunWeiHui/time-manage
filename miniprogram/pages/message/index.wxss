.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  padding-bottom: 100rpx;
}

.message-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.message-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.message-icon.unread {
  background-color: #4A76a8;
  position: relative;
}

.message-icon.unread::after {
  content: '';
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* 未读消息标题加粗 */
.message-item.unread .message-title {
  font-weight: bold;
}

.icon-text {
  font-size: 36rpx;
}

.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.message-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.message-time {
  font-size: 24rpx;
  color: #999;
}

.message-body {
  margin: 8rpx 0;
}

.message-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.message-footer {
  margin-top: 4rpx;
}

.booking-info {
  font-size: 24rpx;
  color: #4A76a8;
}

.message-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 10rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

