.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 筛选器 */
.filter-bar {
  background-color: #ffffff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-options {
  display: flex;
  padding: 0 20rpx;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  transition: all 0.3s;
}

.filter-item.active {
  color: #ffffff;
  background-color: #4a76a8;
}

/* 日程列表 */
.booking-list {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.booking-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.booking-item:active {
  transform: scale(0.98);
}

.booking-item.status-cancelled {
  opacity: 0.6;
}

.booking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.status-pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-badge.status-confirmed {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-badge.status-completed {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-badge.status-cancelled {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.booking-body {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.icon {
  width: 40rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
  text-align: center;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-text.course-content {
  font-weight: 500;
  color: #333;
}

.info-text.remark {
  font-size: 26rpx;
  color: #999;
}

.booking-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.create-time {
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.delete-btn:active {
  background-color: #ff4d4f;
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-state .create-btn {
  background-color: #4a76a8;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 8rpx;
  border: none;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx;
  font-size: 28rpx;
  color: #999;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4a76a8, #73a1d6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 118, 168, 0.4);
  z-index: 100;
  transition: all 0.3s;
}

.fab:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}
