.page {
  min-height: 100vh;
  background-color: #ffffff;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 状态卡片 */
.status-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.status-card.status-pending {
  background-color: #fff7e6;
}

.status-card.status-confirmed {
  background-color: #f6ffed;
}

.status-card.status-completed {
  background-color: #f6ffed;
}

.status-card.status-cancelled {
  background-color: #c4cbcf;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.status-card.status-pending .status-text {
  color: #faad14;
}

.status-card.status-confirmed .status-text {
  color: #52c41a;
}

.status-card.status-completed .status-text {
  color: #52c41a;
}

.status-card.status-cancelled .status-text {
  color: #fff;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.value.time {
  color: #4A76a8;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  border-radius: 6rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.confirm {
  background-color: #4A76a8;
  color: #fff;
}

.complete {
  background-color: #4A76a8;
  color: #fff;
}

.edit {
  background-color: #fff;
  color: #4A76a8;
  border: 1rpx solid #4A76a8;
}

.cancel {
  background-color: #c4cbcf;
  color: #fff;
  border: none;
}


