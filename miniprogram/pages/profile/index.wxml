<view class="page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar">
      <text class="avatar-text">树</text>
    </view>
    <view class="user-info">
      <view class="user-name">小树</view>
      <view class="user-role">一颗小树</view>
    </view>
  </view>

  <!-- 数据 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{stats.studentCount}}</text>
      <text class="stat-label">人员总数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.todayBookings}}</text>
      <text class="stat-label">今日日程</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalBookings}}</text>
      <text class="stat-label">累计日程</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goToBookingList">
      <view class="menu-left">
        <text class="menu-icon">📅</text>
        <text class="menu-label">日程记录</text>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="goToStudentList">
      <view class="menu-left">
        <text class="menu-icon">👥</text>
        <text class="menu-label">通讯录</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="quickAddBooking">
      <text class="action-icon">➕</text>
      <text class="action-label">新建日程</text>
    </view>
    <view class="action-item" bindtap="quickAddStudent">
      <text class="action-icon">👤</text>
      <text class="action-label">添加联系人</text>
    </view>
  </view>
</view>
