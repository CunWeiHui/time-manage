.page {
  min-height: 100vh;
  background-color: #ffffff;
  padding: 20rpx;
  padding-bottom: 140rpx;
}

/* 人员头部 */
.student-header {
  background: linear-gradient(135deg, #4A76a8 0%, #295484 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A76a8;
}

.student-basic {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.student-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.student-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计数据 */
.stats-row {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #4A76a8;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  background-color: #f0f0f0;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.view-all {
  font-size: 26rpx;
  color: #4A76a8;
}

.info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 预约项 */
.booking-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.booking-item:last-child {
  border-bottom: none;
}

.booking-date {
  margin-bottom: 8rpx;
}

.date-text {
  font-size: 28rpx;
  color: #333;
}

.booking-time-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-text {
  font-size: 26rpx;
  color: #4A76a8;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.status-confirmed {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-pending {
  background-color: #fff7e6;
  color: #faad14;
}

.status-completed {
  background-color: #295484;
  color: #fff;
}

.status-cancelled {
  background-color: #c4cbcf;
  color: #fff;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  border-radius: 6rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.primary {
  background-color: #4A76a8;
  color: #fff;
}

.secondary {
  background-color: #fff;
  color: #4A76a8;
  border: 1rpx solid #4A76a8;
}

.danger {
  background-color: #c4cbcf;
  color: #fff;
  border: none;
}
