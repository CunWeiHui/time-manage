<view class="page">
  <view class="form-container">
    <view class="form-section">
      <view class="section-title">基本信息</view>

      <view class="form-item">
        <text class="label">姓名</text>
        <input class="input" placeholder="请输入人员姓名" value="{{formData.name}}" bindinput="onNameInput" />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input class="input" type="number" placeholder="请输入手机号" value="{{formData.phone}}" bindinput="onPhoneInput" maxlength="11" />
      </view>

      <view class="form-item">
        <text class="label">微信号</text>
        <input class="input" placeholder="请输入微信号（选填）" value="{{formData.wechat}}" bindinput="onWechatInput" />
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">备注信息</view>

      <view class="form-item">
        <text class="label">备注</text>
        <textarea class="textarea" placeholder="请输入备注信息（选填）" value="{{formData.remark}}" bindinput="onRemarkInput" maxlength="200" />
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="save-tip" wx:if="{{!canSave}}">
      <text wx:if="{{!formData.name}}">请输入姓名</text>
      <text wx:elif="{{!formData.phone}}">请输入手机号</text>
      <text wx:elif="{{formData.phone.length < 11}}">手机号需为11位</text>
    </view>
    <button class="save-btn" bindtap="saveStudent" disabled="{{!canSave}}">
      {{isSaving ? '' : '保存人员'}}
    </button>
  </view>
</view>
